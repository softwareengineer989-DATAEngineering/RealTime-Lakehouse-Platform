        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% ==========================================================\n%% RealTime Lakehouse Platform\n%% Local Deployment Architecture\n%% ==========================================================\n\nsubgraph Developer[\&quot;Developer Workstation\&quot;]\n    DEV[Developer]\n    IDE[PyCharm / VS Code]\n    GIT[Git Repository]\nend\n\nsubgraph Docker[\&quot;Docker Compose Platform\&quot;]\n\n    subgraph KafkaStack[\&quot;Kafka Layer\&quot;]\n        PRODUCER[Python Kafka Producer]\n        TOPIC[(Kafka Topic)]\n    end\n\n    subgraph SparkStack[\&quot;Spark Structured Streaming\&quot;]\n\n        BRONZE[Bronze Streaming Job]\n\n        SILVER[Silver Streaming Job]\n\n        GOLD[Gold Aggregation Job]\n\n    end\n\nend\n\nsubgraph Storage[\&quot;Persistent Storage\&quot;]\n\n    DATASETS[(Retail Dataset)]\n\n    BRONZE_DELTA[(Bronze Delta)]\n\n    SILVER_DELTA[(Silver Delta)]\n\n    GOLD_DELTA[(Gold Delta)]\n\n    BRONZE_CP[(Bronze Checkpoint)]\n\n    SILVER_CP[(Silver Checkpoint)]\n\n    GOLD_CP[(Gold Checkpoint)]\n\nend\n\nsubgraph Validation[\&quot;Validation Framework\&quot;]\n\n    VALIDATORS[Validation Scripts]\n\n    REPORTS[Validation Reports]\n\n    METRICS[Execution Metrics]\n\n    ARTIFACTS[Validation Artifacts]\n\nend\n\nsubgraph Quality[\&quot;Data Quality\&quot;]\n\n    RULES[Validation Rules]\n\n    INVALID[Invalid Records]\n\nend\n\nDEV --&gt; IDE\n\nIDE --&gt; GIT\n\nDATASETS --&gt; PRODUCER\n\nPRODUCER --&gt; TOPIC\n\nTOPIC --&gt; BRONZE\n\nBRONZE --&gt; BRONZE_DELTA\n\nBRONZE --&gt; BRONZE_CP\n\nBRONZE --&gt; RULES\n\nRULES --&gt;|Valid| SILVER\n\nRULES --&gt;|Invalid| INVALID\n\nINVALID --&gt; ARTIFACTS\n\nSILVER --&gt; SILVER_DELTA\n\nSILVER --&gt; SILVER_CP\n\nSILVER --&gt; GOLD\n\nGOLD --&gt; GOLD_DELTA\n\nGOLD --&gt; GOLD_CP\n\nBRONZE_DELTA --&gt; VALIDATORS\n\nSILVER_DELTA --&gt; VALIDATORS\n\nGOLD_DELTA --&gt; VALIDATORS\n\nVALIDATORS --&gt; REPORTS\n\nVALIDATORS --&gt; METRICS\n\nVALIDATORS --&gt; ARTIFACTS&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VtfiAyooXujVnzmfMde7-71">
